generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Fumo {
  ID          Int    @id @default(autoincrement())
  TITLE       String @default("Fumo!")
  DESCRIPTION String @default("A cute fumo character.")
  FILENAME    String @default("")
  URL         String @default("")
}
