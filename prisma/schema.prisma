// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./fumo.db"
}

model FUMO {
  TITLE       String @default("Fumo!")
  DESCRIPTION String @default("A cute fumo character.")
  FILENAME    String
  URL         String
}
