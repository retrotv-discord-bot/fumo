{
  "name": "fumo",
  "version": "2.0.1",
  "description": "Fumo! Many fumo!!!",
  "license": "Apache-2.0",
  "author": "yjj8353@gmail.com",
  "type": "module",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "bun index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:stop": "pm2 stop fumo-bot",
    "pm2:delete": "pm2 delete fumo-bot",
    "pm2:logs": "pm2 logs fumo-bot",
    "pm2:logrotate:install": "pm2 install pm2-logrotate",
    "pm2:logrotate:daily": "pm2 set pm2-logrotate:rotateInterval '0 0 * * *' && pm2 set pm2-logrotate:dateFormat 'YYYY-MM-DD' && pm2 set pm2-logrotate:retain 14 && pm2 set pm2-logrotate:max_size 100M && pm2 set pm2-logrotate:compress true"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/node": "^24.12.4",
    "eslint": "^10.0.3",
    "eslint-plugin-n": "^17.24.0",
    "globals": "^17.6.0",
    "pino-pretty": "^7.2.0",
    "pm2": "^7.0.1",
    "prettier": "^3.8.3",
    "prisma": "^6.19.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
